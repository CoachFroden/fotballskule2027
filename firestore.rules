rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() {
      return signedIn() && profile().data.role is string ? profile().data.role : '';
    }
    function admin() { return signedIn() && (request.auth.uid == 'aVBlrvavoZbUcELpcIDXuyImuy92'); }
    function instructor() { return role() == 'instructor'; }
    function responsible() { return role() == 'responsible'; }
    function annualRole(year) { return signedIn() && exists(/databases/$(database)/documents/years/$(year)/staffAccess/$(request.auth.uid)) ? get(/databases/$(database)/documents/years/$(year)/staffAccess/$(request.auth.uid)).data.role : ''; }
    function staffYear(year) { return admin() || annualRole(year) in ['instructor','responsible']; }
    function staff() { return admin() || instructor() || responsible(); }

    match /accessRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.status == 'pending' && request.resource.data.requestedRole in ['instructor','responsible'] && request.resource.data.keys().hasOnly(['uid','name','email','requestedRole','status','createdAt']);
      allow update: if admin();
      allow delete: if admin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if admin();
    }
    match /pameldingar2027/{id} {
      allow read, write: if admin();
    }
    match /years/{year} {
      allow list: if signedIn();
      allow get: if staffYear(year);
      allow write: if admin();
      match /staffAccess/{uid} { allow read: if admin() || (signedIn() && request.auth.uid == uid); allow write: if admin(); }
      match /accessRequests/{uid} {
        allow get: if admin() || (signedIn() && request.auth.uid == uid);
        allow list, update, delete: if admin();
        allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.year == year && request.resource.data.status == 'pending' && request.resource.data.requestedRole in ['instructor','responsible'] && request.resource.data.keys().hasOnly(['uid','year','name','email','requestedRole','status','createdAt']);
      }

      match /participants/{id} {
        allow read: if staffYear(year);
        allow write: if admin();
      }
      match /participantPrivate/{id} {
        allow read: if admin() || annualRole(year) == 'responsible';
        allow write: if admin();
      }
      match /instructors/{id} {
        allow read: if staffYear(year);
        allow write: if admin();
      }
      match /instructorPrivate/{id} {
        allow read, write: if admin();
      }
      match /adults/{id} {
        allow read: if staffYear(year);
        allow write: if admin();
        allow update: if signedIn() && annualRole(year) == 'responsible' && request.auth.uid == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','dayIds','days','onboardingComplete','updatedAt']) && request.resource.data.name is string && request.resource.data.dayIds is list && request.resource.data.onboardingComplete == true;
      }
      match /adultPrivate/{id} {
        allow create: if signedIn() && annualRole(year) == 'responsible' && request.auth.uid == id && request.resource.data.keys().hasOnly(['phone','updatedAt']);
        allow read: if admin() || (signedIn() && annualRole(year) == 'responsible' && request.auth.uid == id);
        allow write: if admin();
        allow update: if signedIn() && annualRole(year) == 'responsible' && request.auth.uid == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone','updatedAt']);
      }
      match /days/{id} {
        allow read: if staffYear(year);
        allow write: if admin();
      }
      match /instructorPlans/{id} {
        allow read: if staffYear(year);
        allow write: if admin();
      }
      match /attendance/{session}/entries/{id} {
        allow read: if admin() || annualRole(year) == 'instructor';
        allow write: if admin() || annualRole(year) == 'instructor';
      }
      match /{document=**} {
        allow read, write: if admin();
      }
    }
    match /{document=**} {
      allow read, write: if admin();
    }
  }
}
